  "dialogue.longyou.greeting": "[尸王·龙右] 你来了，我的部下。",
  "dialogue.longyou.option.command": "大人您有何吩咐？",
  "dialogue.longyou.option.task": "任务升级系统",
  "dialogue.longyou.option.appointment": "尸王钦点",
  "dialogue.longyou.option.about": "关于尸族",

  "dialogue.longyou.command.line1": "§6§l[尸王·龙右] §r我的部下，去为我收集更多的生命力，壮大我尸族的势力。",
  "dialogue.longyou.command.line2": "§6§l[尸王·龙右] §r消灭那些反抗我们的人类，将他们转化为我们的同类。",
  "dialogue.longyou.command.line3": "§6§l[尸王·龙右] §r当你变得足够强大时，我会赐予你更强大的力量。",

  "dialogue.longyou.task.line1": "§6§l[尸王·龙右] §r我已为你开通了任务系统，完成任务可获得进化点和特殊奖励。",
  "dialogue.longyou.task.line2": "§6§l[尸王·龙右] §r任务分为：消灭人类、感染村民、收集资源等多种类型。",
  "dialogue.longyou.task.line3": "§6§l[尸王·龙右] §r完成的任务越多，你的等级越高，获得的奖励也越丰厚。",

  "dialogue.longyou.appointment.line1": "§6§l[尸王·龙右] §r作为我的部下，你展现出了非凡的潜力。",
  "dialogue.longyou.appointment.line2": "§6§l[尸王·龙右] §r我钦点你为尸族的精英战士，赐予你特殊的能力。",
  "dialogue.longyou.appointment.line3": "§6§l[尸王·龙右] §r好好利用这份力量，为尸族的崛起而战！",

  "dialogue.longyou.about.line1": "§6§l[尸王·龙右] §r我们尸族是这个世界的新主宰，将取代脆弱的人类。",
  "dialogue.longyou.about.line2": "§6§l[尸王·龙右] §r通过不断进化，我们将变得更加强大，无可匹敌。",
  "dialogue.longyou.about.line3": "§6§l[尸王·龙右] §r尸族的未来，就掌握在你们这些部下的手中。",

  "dialogue.longyou.invalid_option": "§4§l无效的选项！",
  "dialogue.longyou.only_corpse": "§4§l只有尸兄才能与尸王对话！",
  "dialogue.longyou.rebellion": "§4§l[尸王·龙右] §r你竟敢对我动手，视为造反！",
  "dialogue.longyou.rebellion.broadcast": "§4§l[尸王·龙右] §r%s 竟敢对我动手，视为造反！",

  "dialogue.longyou.option.receive_mission": "领取任务",
  "dialogue.longyou.option.submit_mission": "提交任务",
  
  "dialogue.longyou.mission.already_has": "§c§l[尸王·龙右] §r你已有未完成的任务，先去完成它！",
  "dialogue.longyou.mission.received": "§a§l[尸王·龙右] §r这是你的任务纸条，完成后拿来给我。任务：%s",
